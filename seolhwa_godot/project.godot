; Engine configuration file.
config_version=5

[application]

config/name="설화록"
run/main_scene="res://scenes/region.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="mobile"

lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=2

[shader_globals]

hemi_sky={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
hemi_ground={
"type": "vec3",
"value": Vector3(0.3, 0.3, 0.3)
}
hemi_i={
"type": "float",
"value": 1.0
}
fog_color={
"type": "vec3",
"value": Vector3(0.8, 0.8, 0.8)
}
fog_density={
"type": "float",
"value": 0.0
}
glow_k={
"type": "float",
"value": 0.0
}
fog_base={
"type": "float",
"value": 0.0
}
occ_a={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
occ_b={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
occ_r={
"type": "float",
"value": 0.0
}
occ_near={
"type": "float",
"value": 0.0
}
wet={
"type": "float",
"value": 0.0
}
snow={
"type": "float",
"value": 0.0
}
snow_line={
"type": "float",
"value": 100000.0
}
