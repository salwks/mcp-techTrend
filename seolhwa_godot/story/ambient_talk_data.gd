static func register(kind: String) -> String:
	return String(REGISTER.get(kind, "hao"))

# 줄 수 세기(보고서·시험)
static func count_lines() -> int:
	var n := 0
	for k in KIND:
		for c in KIND[k]: n += (KIND[k][c] as Array).size()
	for t in [MODE, ARCH, ZONE]:
		for k in t:
			for c in t[k]: n += (t[k][c] as Array).size()
	for c in WEATHER: n += (WEATHER[c] as Array).size()
	for r in REGION:
		for c in REGION[r]: n += (REGION[r][c] as Array).size()
	for o in OUTCOME:
		for key in ["lines", "lines_hage"]:
			for v in o.get(key, {}): n += (o[key][v] as Array).size()
	for t in [RUMOR_LEAD, BRUSH, REPEAT]:
		for k in t: n += (t[k] as Array).size()
	return n
