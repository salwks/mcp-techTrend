# 재질 디테일 텍스처 굽기 — GPU에서 tools/matlight/pbr_bake.gdshader를 층마다 그려 assets/pbr/에 둔다(창 필요, 결정적).
#   godot --path . -s res://tools/matlight/bake_pbr.gd -- --bake=1
# 결과: assets/pbr/pbr_a.res · pbr_b.res(Texture2DArray, 밉맵, BC3 압축), assets/pbr/preview/*.png(층별 미리보기), manifest.json
# 층 순서·크기·깊이는 scripts/render/pbr.gd LAYERS와 shaders/pbr_common.gdshaderinc M_* 표가 같아야 한다.
extends SceneTree

const Pbr := preload("res://scripts/render/pbr.gd")
const RES := 512

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	var vp := SubViewport.new()
	vp.size = Vector2i(RES, RES)
	vp.transparent_bg = true
	vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	vp.disable_3d = true
	root.add_child(vp)
	var rect := ColorRect.new()
	rect.size = Vector2(RES, RES)
	var mat := ShaderMaterial.new()
	mat.shader = load("res://tools/matlight/pbr_bake.gdshader")
	rect.material = mat
	vp.add_child(rect)
	var outdir := ProjectSettings.globalize_path("res://assets/pbr/")
	DirAccess.make_dir_recursive_absolute(outdir + "preview")
	var imgs := [[], []]
	var t0 := Time.get_ticks_msec()
	for li in Pbr.LAYERS.size():
		var L: Dictionary = Pbr.LAYERS[li]
		for mode in 2:
			mat.set_shader_parameter("layer", li)
			mat.set_shader_parameter("mode", mode)
			mat.set_shader_parameter("res", float(RES))
			mat.set_shader_parameter("slope_k", float(L.depth) / float(L.tile))
			for f in 3: await RenderingServer.frame_post_draw
			var img := vp.get_texture().get_image()
			img.convert(Image.FORMAT_RGBA8)
			if OS.get_cmdline_user_args().has("--preview"): img.save_png(outdir + "preview/%02d_%s_%s.png" % [li, L.name, "a" if mode == 0 else "b"])
			imgs[mode].append(img)
	print("BAKE drawn %d layers in %d ms" % [Pbr.LAYERS.size(), Time.get_ticks_msec() - t0])
	var names := ["pbr_a", "pbr_b"]
	var total := 0
	for mode in 2:
		var arr: Array[Image] = []
		for im in imgs[mode]:
			var c: Image = im.duplicate()
			c.generate_mipmaps()
			var err := c.compress(Image.COMPRESS_S3TC, Image.COMPRESS_SOURCE_GENERIC)
			if err != OK: print("BAKE compress failed ", err)
			arr.append(c)
			total += c.get_data().size()
		var tex := Texture2DArray.new()
		tex.create_from_images(arr)
		var p := "res://assets/pbr/%s.res" % names[mode]
		var e2 := ResourceSaver.save(tex, p, ResourceSaver.FLAG_COMPRESS)
		print("BAKE saved ", p, " err=", e2, " format=", arr[0].get_format())
	var man := { generator = "tools/matlight/bake_pbr.gd + tools/matlight/pbr_bake.gdshader (procedural, GPU)", license = "CC0 — procedurally generated by this project, no third-party source images",
		resolution = RES, compression = "S3TC/BC3 + mipmaps", vram_bytes = total, layers = [] }
	for li in Pbr.LAYERS.size():
		var L: Dictionary = Pbr.LAYERS[li]
		man.layers.append({ index = li, name = L.name, ko = L.ko, tile_m = L.tile, depth_m = L.depth, source = "procedural" })
	var f := FileAccess.open(outdir + "manifest.json", FileAccess.WRITE)
	f.store_string(JSON.stringify(man, "  ")); f.close()
	print("BAKE done vram=%.1fMB" % (total / 1048576.0))
	quit()
